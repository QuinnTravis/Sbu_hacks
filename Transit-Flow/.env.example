# AI event detection (games, concerts, festivals near the network). Server-side
# only: read by the Vite dev/preview server for /api/events, never sent to the
# browser. Without it, only the public MLB schedule for Citi Field is checked.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: where a deployed event detector lives (defaults to /api/events).
VITE_EVENTS_URL=
# Optional: JSON proxy for MTA GTFS-Realtime (see engine/realtime.ts).
VITE_REALTIME_PROXY_URL=
