# Which LLM provider generateJson() uses. Only "gemini" is implemented.
LLM_PROVIDER=gemini
# Free key, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Flash-Lite: ~10 s per deck. gemini-flash-latest is a thinking model and took 79 s (over the 40 s budget). Pro models are paid.
GEMINI_MODEL=gemini-flash-lite-latest
PORT=8787
# Sound effects (npm run sfx -w client) and eyes-free narration (/api/tts).
# Key permissions needed: Sound Effects and Text to Speech. Without it, narration uses the browser's voice.
# Free key: https://elevenlabs.io (Developers > API keys)
ELEVENLABS_API_KEY=
# Optional narration overrides (defaults: "George" voice, low-latency Flash model)
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
