NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Needed by CLI publishing jobs, never by the browser.
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VERIFIER_MODEL=gemini-2.5-flash-lite
SERPER_API_KEY=
ELEVENLABS_API_KEY=
# George: warm storytelling voice. Override with a voice ID from your library.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2
# Shared character cap per UTC month. Cached clips do not consume this allowance.
ELEVENLABS_MONTHLY_CHARACTER_LIMIT=9000
GOOGLE_PLACES_API_KEY=
# A random value, at least 32 characters. Used to hash rate-limit identifiers.
RATE_LIMIT_SECRET=
# Only use trusted forwarding headers when your reverse proxy overwrites them.
TRUST_PROXY=false
